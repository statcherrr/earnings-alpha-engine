# Earnings Alpha Engine — example environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- General ---
# One of: development, testing, production. Controls logging verbosity only.
EARNINGS_ALPHA_ENV=development

# --- Data provider API keys (all optional in Phase 1) ---
# Placeholder only; no external API calls are made during Phase 1.
# EARNINGS_ALPHA_API_KEY=your-api-key-here

# --- Research parameters ---
# Directory where raw/processed/market data live. Defaults to ./data.
# EARNINGS_ALPHA_DATA_DIR=./data

# Random seed for reproducible sampling. Defaults to 42.
# EARNINGS_ALPHA_RANDOM_SEED=42
